# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 — builder: compile the Vite/React application
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests first to leverage Docker layer cache
COPY frontend/package.json frontend/package-lock.json ./

# Clean install — uses exact versions from package-lock.json
RUN npm ci

# Copy the rest of the frontend source
COPY frontend/ .

# Accept the API base URL at build time so Vite can inline it
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Produce the optimised production bundle
RUN npm run build


# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — serve: ship the static bundle via nginx
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:alpine AS serve

# Remove the default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy our custom nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# nginx foreground mode is the default CMD in the official image
